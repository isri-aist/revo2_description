<?xml version="1.0" ?>
<robot name="Revo2_RightHand">

  <!-- ===================================================== -->
  <!-- PALM -->
  <!-- ===================================================== -->

  <planar_surface name="RightPalm" link="right_base_link">
    <origin xyz="0 0 0.085" rpy="0 0 0" />
