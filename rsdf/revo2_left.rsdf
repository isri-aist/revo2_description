<?xml version="1.0" encoding="UTF-8"?>

<robot name="brainco_revo2_left_hand">

  <!-- ===================================================== -->
  <!-- PALM -->
  <!-- ===================================================== -->

  <surface name="LeftPalm" type="planar">
    <link name="left_base_link"/>
    <origin xyz="0.000 0.000 0.085" rpy="0 0 0"/>
    <points>
      -0.030 -0.040 0
       0.030 -0.040 0
       0.030  0.040 0
      -0.030  0.040 0
    </points>
  </surface>

